# Base de donnees
POSTGRES_DB=ce_avocat
POSTGRES_USER=ce_avocat_user
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL="postgresql://ce_avocat_user:changeme_strong_password@ce-avocat-db:5432/ce_avocat"

# Auth.js
AUTH_SECRET=changeme_generate_with_openssl_rand_base64_32
AUTH_URL=https://ce-avocats.legeai-editions.com

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=CE Avocats <noreply@ce-avocats.legeai-editions.com>

# Formulaire de contact (facultatif) : adresse qui recoit les messages.
# Elle reste cote serveur, jamais dans les pages. Par defaut : administration@legeai-editions.com
# CONTACT_EMAIL=administration@legeai-editions.com

# Mot de passe du compte administrateur (admin@ce-avocats.fr). A DEFINIR en production :
# il remplace a chaque demarrage le mot de passe de demonstration, public.
ADMIN_PASSWORD=changeme_long_mot_de_passe_unique

# Politique de securite du contenu : publiee en mode "rapport" par defaut.
# Apres verification de la console du navigateur en production, passer a true pour l appliquer.
# CSP_ENFORCE=true
